# 无状态 worker（persist/deliver/ghost）共用模板：PG + Kafka，无 HTTP 端口
debug: false
version: "v1"
log:
  level: "info"
  output: "stdout"
kafka:
  brokers: "${KAFKA_BROKERS}"
# ghost 对账依赖 etcd 服务表（存活 CS 集合）；persist/deliver 不消费该段，无副作用
etcd:
  dial_timeout: 5
  endpoints: "${ETCD_ENDPOINTS}"
postgres:
  user: "${POSTGRES_USER}"
  password: "${POSTGRES_PASSWORD}"
  server: "${POSTGRES_HOST}"
  port: 5432
  database: "${POSTGRES_DB}"
