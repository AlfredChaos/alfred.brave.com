# Brave Push Worker (offline notify)。
[Unit]
Description=Brave IM Push Worker (offline notify)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PROJECT_PATH=/etc/brave
EnvironmentFile=/etc/brave/env
ExecStart=/usr/local/bin/brave push
Restart=always
RestartSec=2
LimitNOFILE=500000
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
