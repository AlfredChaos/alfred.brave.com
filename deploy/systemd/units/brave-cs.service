# Brave Chat Server（joker）。连接档 LimitNOFILE=800000：pam limits 对 systemd
# 不生效，必须写在这里（30 万连接 + 程序自身 fd）。2+1' 拓扑的 node-3 用
# brave-cs-node3.service（带 MemoryMax=5G 限容）。
[Unit]
Description=Brave IM Chat Server (joker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PROJECT_PATH=/etc/brave
EnvironmentFile=/etc/brave/env
ExecStart=/usr/local/bin/brave joker
Restart=always
RestartSec=2
LimitNOFILE=800000
# 崩溃重启即部署层兜底（worker 致命退出非零码语义见 commands/*）
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
