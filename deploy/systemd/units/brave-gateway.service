# Brave Gateway (REST entry)。
[Unit]
Description=Brave IM Gateway (REST entry)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PROJECT_PATH=/etc/brave
EnvironmentFile=/etc/brave/env
ExecStart=/usr/local/bin/brave start
Restart=always
RestartSec=2
LimitNOFILE=500000
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
