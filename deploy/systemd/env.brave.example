# Brave systemd 部署环境（每台一份，复制去 /etc/brave/env 后改真实值）
PROJECT_PATH=/etc/brave
# PG（原生装在 node-1）
POSTGRES_HOST=10.0.0.11
POSTGRES_USER=brave
POSTGRES_PASSWORD=change-me-app
POSTGRES_DB=brave
# 中间件（混部=三台列表 / 2+1'=仅 node-3）
KAFKA_BROKERS=10.0.0.11:9092,10.0.0.12:9092,10.0.0.13:9092
ETCD_ENDPOINTS=10.0.0.11:2379,10.0.0.12:2379,10.0.0.13:2379
AUTH_SECRET=change-me-secret
# 本节点 advertise（cs 注册与 ws_addr 下发用本机真实 IP）
ADVERTISE_HOST=10.0.0.11
ADVERTISE_PORT=37002
GRPC_ADVERTISE_HOST=10.0.0.11
JOKER_GRPC_PORT=37012
