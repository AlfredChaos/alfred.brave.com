# ============================================================
# Alfred Brave 生产三节点拓扑环境变量（复制为 .env 后填写真实 IP）
# 机器规格：3 × 4C16G + 200G SSD（架构文档 §9）
# 注意：本文件是占位符模板，从未在真实环境执行过（见 README.md）
# ============================================================

# --- 节点 IP（唯一需要修改的三行）---
NODE1_IP=10.0.0.11
NODE2_IP=10.0.0.12
NODE3_IP=10.0.0.13

# --- 集群共享配置 ---
# etcd 集群名与 token（多环境隔离）
ETCD_CLUSTER_TOKEN=brave-prod
# PG 复制账号（primary 建号，replica 用它拉流）
POSTGRES_REPLICATION_PASSWORD=change-me-repl
POSTGRES_PASSWORD=change-me-app
POSTGRES_USER=brave
POSTGRES_DB=brave
# 网关鉴权密钥（gateway 与 feed-api 共享，务必改掉默认值）
AUTH_SECRET=change-me-secret
# Kafka
KAFKA_HEAP_OPTS=-Xmx1g -Xms1g

# --- 域名/证书（可选，若网关前置 LB 则填公网域名）---
# GATEWAY_PUBLIC_HOST=im.example.com
